# Copy to backend/.env and adjust.
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public URL of the web app (used in payment links, QR codes and emails).
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (empty = allow all, fine for local dev).
CORS_ORIGINS=

# Database: leave DATABASE_URL empty to use SQLite at SQLITE_FILE,
# or point it at PostgreSQL, e.g. postgres://user:pass@localhost:5432/payflex
DATABASE_URL=
SQLITE_FILE=./data/payflex.sqlite

# Accounts with these emails become admins on sign-up (the very first account always does).
ADMIN_EMAILS=

CURRENCY=ZAR
PAYMENT_EXPIRY_HOURS=72
TZ_REPORTS=Africa/Johannesburg

# SMTP (optional). Without SMTP_HOST emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PayFlex <no-reply@payflex.local>

WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=3
